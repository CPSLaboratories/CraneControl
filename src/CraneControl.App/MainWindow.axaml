<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CraneControl.App.ViewModels"
        xmlns:views="using:CraneControl.App.Views"
        x:Class="CraneControl.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Sterowanie dźwignicą dydaktyczną"
        Icon="avares://CraneControl.App/Assets/crane-icon.png"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Focusable="True">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Classes="headerBar">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{StaticResource CraneIconGlyph}" FontSize="28"/>
                    <StackPanel>
                        <TextBlock Text="Sterowanie dźwignicą dydaktyczną" Classes="appTitle"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Sterownik PLC:" Classes="fieldLabel" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PlcHost}" Watermark="Adres IP" Width="170"/>
                        <NumericUpDown Value="{Binding PlcPort}" Minimum="1" Maximum="65535" FormatString="0" Width="130"/>
                        <Button Content="Połącz" Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding !IsConnectingToPlc}" Classes="accent"/>
                        <ToggleSwitch IsChecked="{Binding IsRealPlcMode}"
                                      OnContent="Rzeczywisty PLC" OffContent="Symulacja"
                                      ToolTip.Tip="{Binding ConnectionMessage}"/>
                    </StackPanel>

                    <Border Classes="statusPill" Classes.ok="{Binding IsConnected}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionStatusIcon}" Classes="statusIcon"/>
                            <TextBlock Text="{Binding StatusMessage}" Classes="statusText"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Oś X — ruch poziomy">
                <views:AxisXView DataContext="{Binding AxisX}" Margin="0,12,0,0"/>
            </TabItem>
            <TabItem Header="Oś Y — podnoszenie">
                <views:AxisYView DataContext="{Binding AxisY}" Margin="0,12,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
