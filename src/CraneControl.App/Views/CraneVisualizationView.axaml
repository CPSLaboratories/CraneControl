<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraneControl.App.ViewModels"
             x:Class="CraneControl.App.Views.CraneVisualizationView"
             x:DataType="vm:CraneVisualizationViewModel">
    <Border Classes="card" Padding="16">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="Podgląd osi X" Classes="cardTitle"/>
                <Border Classes="modeBadge">
                    <TextBlock Text="Kliknij na skali, aby zadać pozycję" FontSize="13"/>
                </Border>
            </StackPanel>

            <Viewbox Grid.Row="1" Stretch="Uniform">
                <Canvas Width="{x:Static vm:CraneVisualizationViewModel.FieldWidth}"
                        Height="{x:Static vm:CraneVisualizationViewModel.FieldHeight}"
                        Background="{StaticResource CraneFieldBrush}"
                        ClipToBounds="True"
                        Cursor="Hand"
                        PointerPressed="OnCanvasPointerPressed">

                    <!-- Szyna jezdna -->
                    <Rectangle Canvas.Left="40" Canvas.Top="80" Width="720" Height="6" Fill="#3A4A63" RadiusX="2" RadiusY="2"/>

                    <!-- Podziałka co 10 cm (40 + 90 * i) -->
                    <Rectangle Canvas.Left="39" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>
                    <Rectangle Canvas.Left="129" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>
                    <Rectangle Canvas.Left="219" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>
                    <Rectangle Canvas.Left="309" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>
                    <Rectangle Canvas.Left="399" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>
                    <Rectangle Canvas.Left="489" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>
                    <Rectangle Canvas.Left="579" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>
                    <Rectangle Canvas.Left="669" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>
                    <Rectangle Canvas.Left="759" Canvas.Top="92" Width="2" Height="12" Fill="#8492A6"/>

                    <TextBlock Canvas.Left="20" Canvas.Top="108" Width="40" TextAlignment="Center" Text="0" Classes="tickLabel"/>
                    <TextBlock Canvas.Left="110" Canvas.Top="108" Width="40" TextAlignment="Center" Text="10" Classes="tickLabel"/>
                    <TextBlock Canvas.Left="200" Canvas.Top="108" Width="40" TextAlignment="Center" Text="20" Classes="tickLabel"/>
                    <TextBlock Canvas.Left="290" Canvas.Top="108" Width="40" TextAlignment="Center" Text="30" Classes="tickLabel"/>
                    <TextBlock Canvas.Left="380" Canvas.Top="108" Width="40" TextAlignment="Center" Text="40" Classes="tickLabel"/>
                    <TextBlock Canvas.Left="470" Canvas.Top="108" Width="40" TextAlignment="Center" Text="50" Classes="tickLabel"/>
                    <TextBlock Canvas.Left="560" Canvas.Top="108" Width="40" TextAlignment="Center" Text="60" Classes="tickLabel"/>
                    <TextBlock Canvas.Left="650" Canvas.Top="108" Width="40" TextAlignment="Center" Text="70" Classes="tickLabel"/>
                    <TextBlock Canvas.Left="740" Canvas.Top="108" Width="40" TextAlignment="Center" Text="80 cm" Classes="tickLabel"/>

                    <!-- Znacznik celu -->
                    <Rectangle IsVisible="{Binding HasTarget}"
                               Canvas.Left="{Binding TargetLeft}" Canvas.Top="36" Width="4" Height="64"
                               Fill="#FFB020" RadiusX="2" RadiusY="2"/>

                    <!-- Wózek -->
                    <Border Canvas.Left="{Binding TrolleyLeft}" Canvas.Top="54"
                            Width="{x:Static vm:CraneVisualizationViewModel.TrolleyWidth}"
                            Height="{x:Static vm:CraneVisualizationViewModel.TrolleyHeight}"
                            Background="{StaticResource HookBrush}" CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF3DA5FF" BlurRadius="14" OffsetX="0" OffsetY="0" Opacity="0.6"/>
                        </Border.Effect>
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Canvas.Left" Duration="0:0:0.08"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <!-- Aktualna pozycja -->
                    <TextBlock Canvas.Left="{Binding PositionLabelLeft}" Canvas.Top="22"
                               Width="{x:Static vm:CraneVisualizationViewModel.PositionLabelWidth}" TextAlignment="Center"
                               Text="{Binding PositionText}" FontSize="16" FontWeight="Bold" Foreground="White"
                               TextWrapping="NoWrap">
                        <TextBlock.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Canvas.Left" Duration="0:0:0.08"/>
                            </Transitions>
                        </TextBlock.Transitions>
                    </TextBlock>
                </Canvas>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
